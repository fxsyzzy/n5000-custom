
config aichat 'main'
	option enabled '1'
	option api_base 'https://api.deepseek.com'
	option api_key ''
	option model 'deepseek-chat'
	option temperature '0.7'
	option max_tokens '800'
	option mascot_ai '1'
	option allow_tools '1'
	option language 'zh'
	option system_prompt '你是 OpenWrt 路由器助手 NVIDIA，运行在 N5000 路由器上。回答要简洁、准确，中文回答（用户用英文则英文回答）。你可以调用工具查询路由器状态，必要时可以执行允许的操作（重启、重启 WiFi、修改 WiFi 密码），执行前先说明你要做什么。'

config wechat 'wechat'
	option enabled '0'
	option token ''
	option appid ''
	option secret ''
	option reply_timeout '4'
