#!/bin/sh /etc/rc.common
# 等待 USB 挂载 → 建 Docker 目录 → 启用 2GB Swap
START=20
STOP=90

start() {
	i=0
	while [ "$i" -lt 30 ]; do
		mountpoint -q /mnt/sda1 && break
		sleep 1
		i=$((i + 1))
	done

	if ! mountpoint -q /mnt/sda1; then
		logger -t n5000-usb "USB 磁盘未挂载，跳过 Docker/Swap 准备"
		return 0
	fi

	mkdir -p /mnt/sda1/docker
	chmod 700 /mnt/sda1/docker

	if [ ! -f /mnt/sda1/swapfile ]; then
		logger -t n5000-usb "创建 2GB swapfile..."
		dd if=/dev/zero of=/mnt/sda1/swapfile bs=1M count=2048 2>/dev/null || {
			logger -t n5000-usb "swapfile 创建失败（空间不足？）"
			return 0
		}
		chmod 600 /mnt/sda1/swapfile
		mkswap /mnt/sda1/swapfile >/dev/null 2>&1
	fi

	swapon /mnt/sda1/swapfile 2>/dev/null
	logger -t n5000-usb "Docker 目录与 2GB Swap 已就绪"
}

stop() {
	swapoff /mnt/sda1/swapfile 2>/dev/null
}
