#!/bin/sh /etc/rc.common
# 每次启动检查并清理厂家标识（SSID / 主机名 / banner）
START=21

start() {
	changed=0

	# 主机名
	cur_host="$(uci -q get system.@system[0].hostname)"
	case "$cur_host" in
		*NRadio*|*N5000*|*nradio*)
			uci set system.@system[0].hostname='OpenWrt'
			uci commit system
			changed=1
			;;
	esac

	# 无线 SSID
	for s in $(uci -q show wireless 2>/dev/null | grep '\.ssid=' | cut -d. -f1-2); do
		cur_ssid="$(uci -q get "$s.ssid")"
		case "$cur_ssid" in
			*NRadio*|*N5000*|*nradio*)
				band="$(uci -q get "$s.band")"
				case "$band" in
					2g) uci set "$s.ssid=OpenWrt-2G" ;;
					5g) uci set "$s.ssid=OpenWrt-5G" ;;
					*) uci set "$s.ssid=OpenWrt" ;;
				esac
				changed=1
				;;
		esac
	done

	if [ "$changed" = "1" ]; then
		uci commit wireless 2>/dev/null
		logger -t n5000-debrand "已清理厂家标识（主机名/SSID）"
		wifi reload >/dev/null 2>&1
	fi
}
