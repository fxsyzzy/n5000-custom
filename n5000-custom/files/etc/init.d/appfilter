#!/bin/sh /etc/rc.common
# 自研应用过滤服务
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/appfilter daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	/usr/sbin/appfilter stop >/dev/null 2>&1
	nft delete table inet appfilter 2>/dev/null
}
