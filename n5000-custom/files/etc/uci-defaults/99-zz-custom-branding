#!/bin/sh
# 去厂化 / 去标识 / 网络与 Docker 首次启动配置（只执行一次）
[ "$(board_name)" = "nradio,n5000" ] || exit 0

# 1) 系统标识
uci set system.@system[0].hostname='OpenWrt'
uci set system.@system[0].description='OpenWrt'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system
printf 'OpenWrt\n' > /etc/banner

# 2) Argon 主题
uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci

# 3) 无线名称去掉厂商标识（band 属性在 wifi-device 上，不在 wifi-iface 上）
for iface in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
	dev="$(uci -q get "wireless.$iface.device")"
	band="$(uci -q get "wireless.$dev.band")"
	case "$band" in
		2g) uci set "wireless.$iface.ssid=OpenWrt-2G" ;;
		5g) uci set "wireless.$iface.ssid=OpenWrt-5G" ;;
		6g) uci set "wireless.$iface.ssid=OpenWrt-6G" ;;
	esac
done
uci commit wireless 2>/dev/null

# 4) Docker：数据目录在 USB 外挂盘 + 使用 nftables 防火墙后端
#    通过 alt_config_file 指向 /etc/dockerd.json，避免 Docker 生成 legacy iptables 链
#    （OpenWrt 默认 fw4/nftables，混用会触发 LuCI 警告）
if [ -f /etc/config/dockerd ]; then
	uci set dockerd.globals.alt_config_file='/etc/dockerd.json'
	uci set dockerd.globals.iptables='0'
	uci commit dockerd
fi

# 5) 启用每次启动的品牌清理脚本
[ -x /etc/init.d/n5000-debrand ] && /etc/init.d/n5000-debrand enable >/dev/null 2>&1

# 6) 改 LAN 网段，避免与上级路由器冲突（上级常用 192.168.1.1）
if uci -q get network.lan >/dev/null 2>&1; then
	uci set network.lan.ipaddr='192.168.88.1'
	uci set network.lan.netmask='255.255.255.0'
	uci commit network
	uci set dhcp.lan.start='100'
	uci set dhcp.lan.limit='150'
	uci set dhcp.lan.leasetime='12h'
	uci commit dhcp
fi

exit 0
