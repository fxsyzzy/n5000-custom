#!/bin/sh
# 首次启动：生成本地 CA + 服务器证书（SAN 含 192.168.88.1），供浏览器导入后免警告
D=/etc/uhttpd-ca
[ -f "$D/server.crt" ] && exit 0
mkdir -p "$D"
cd "$D" || exit 0

openssl genrsa -out ca.key 2048 2>/dev/null
openssl req -x509 -new -nodes -key ca.key -sha256 -days 3650 \
	-subj "/C=CN/O=DeepWrt/CN=DeepWrt Local CA" \
	-addext "basicConstraints=critical,CA:TRUE" \
	-addext "keyUsage=critical,keyCertSign,cRLSign" \
	-out ca.crt 2>/dev/null

cat > ext.cnf <<'EOF'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=IP:192.168.88.1,DNS:DeepWrt.lan,DNS:DeepWrt,DNS:localhost,IP:127.0.0.1
EOF
openssl req -new -nodes -newkey rsa:2048 -keyout server.key \
	-subj "/C=CN/O=DeepWrt/CN=192.168.88.1" -out server.csr 2>/dev/null
openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial \
	-out server.crt -days 825 -sha256 -extfile ext.cnf 2>/dev/null
chmod 600 ca.key server.key
chmod 644 ca.crt server.crt

uci -q set uhttpd.main.cert='/etc/uhttpd-ca/server.crt'
uci -q set uhttpd.main.key='/etc/uhttpd-ca/server.key'
uci -q commit uhttpd

mkdir -p /www/luci-static/n5000
cp -f ca.crt /www/ca.crt
cp -f ca.crt /www/luci-static/n5000/deepwrt-ca.crt
chmod 644 /www/ca.crt /www/luci-static/n5000/deepwrt-ca.crt
exit 0
