#!/bin/sh
# 大肥鱼全局挂件：注入 Argon 主题页面脚本（所有已登录 LuCI 页面左下角常驻）
[ -f /www/luci-static/n5000/mascot.js ] || exit 0

inject() {
	f="$1"
	[ -f "$f" ] || return 0
	grep -q 'n5000/mascot.js' "$f" 2>/dev/null && return 0
	grep -q '{% endif %}' "$f" || return 0
	sed -i '/{% endif %}/i <script type="text/javascript" src="/luci-static/n5000/mascot.js"></script>' "$f"
}

inject /usr/share/ucode/luci/template/themes/argon/page_scripts.ut
inject /usr/share/ucode/luci/template/themes/carbon/page_scripts.ut

exit 0
