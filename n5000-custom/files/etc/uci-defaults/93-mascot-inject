#!/bin/sh
# 全局挂件：注入 Argon/Carbon 主题页面脚本（大肥鱼 + 顶部快捷面板入口）
[ -f /www/luci-static/n5000/mascot.js ] || exit 0
[ -f /www/luci-static/n5000/quicks.js ] || exit 0

inject() {
	f="$1"
	[ -f "$f" ] || return 0
	# 先清掉旧注入，保证幂等
	sed -i '/luci-static\/n5000\/\(mascot\|quicks\)\.js/d' "$f" 2>/dev/null
	grep -q '{% endif %}' "$f" || return 0
	sed -i '/{% endif %}/i <script type="text/javascript" src="/luci-static/n5000/mascot.js"></script>\n<script type="text/javascript" src="/luci-static/n5000/quicks.js"></script>' "$f"
}

inject /usr/share/ucode/luci/template/themes/argon/page_scripts.ut
inject /usr/share/ucode/luci/template/themes/carbon/page_scripts.ut

exit 0
