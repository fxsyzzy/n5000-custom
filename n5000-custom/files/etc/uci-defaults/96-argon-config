#!/bin/sh
# Argon 主题统一配置：深色玻璃模式 + 薄荷绿强调色（与仪表盘一致）
[ -f /etc/config/argon ] || exit 0
uci -q set argon.@global[0].mode='light'
uci -q set argon.@global[0].primary='#111111'
uci -q set argon.@global[0].dark_primary_mode='custom'
uci -q set argon.@global[0].dark_primary='#FAFAFA'
uci -q set argon.@global[0].dark_glass_mode='off'
uci -q set argon.@global[0].blur_dark='0'
uci -q set argon.@global[0].transparency_dark='0.35'
uci -q set argon.@global[0].main_glass='0'
uci -q commit argon
exit 0

