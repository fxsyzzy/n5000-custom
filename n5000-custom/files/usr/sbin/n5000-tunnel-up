#!/bin/sh
# 一键恢复 Tailscale 登录 + Funnel（刷机或更换 key 后执行）
KEYFILE=/etc/tailscale/authkey
[ -f "$KEYFILE" ] || { echo "缺少 $KEYFILE（把 tskey-auth-... 写入该文件）"; exit 1; }
/usr/sbin/tailscaled >/dev/null 2>&1 &
sleep 2
tailscale up --authkey="$(cat "$KEYFILE")" --hostname=n5000 --accept-dns=false --accept-routes=false || exit 1
sleep 3
tailscale funnel --bg 8081
tailscale funnel status