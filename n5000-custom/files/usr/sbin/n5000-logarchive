#!/bin/sh
# 日志持久化 / 审计留存（增量）：只归档上次之后的新关键日志
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

DIR=/root/logs
LOG="$DIR/system.log"
MARK="$DIR/.lastlog"
MAX=524288
mkdir -p "$DIR"

[ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt "$MAX" ] && mv -f "$LOG" "$LOG.1"

PATTERN='dispatcher\.uc|dropbear|authpriv|daemon\.err|daemon\.warning|daemon\.crit|daemon\.alert|kernel: .*(error|fail|panic|OOM|reset)|[Rr]eboot|[Ss]ysupgrade'
logread 2>/dev/null | grep -E "$PATTERN" > /tmp/n5000-log.all 2>/dev/null
[ -s /tmp/n5000-log.all ] || { rm -f /tmp/n5000-log.all; exit 0; }

if [ -f "$MARK" ]; then
	last=$(cat "$MARK" 2>/dev/null)
	awk -v last="$last" 'found { print } $0 == last { found = 1 }' /tmp/n5000-log.all > /tmp/n5000-log.new
else
	cp /tmp/n5000-log.all /tmp/n5000-log.new
fi

if [ -s /tmp/n5000-log.new ]; then
	echo "===== archive $(date '+%F %T') =====" >> "$LOG"
	cat /tmp/n5000-log.new >> "$LOG"
	tail -n 1 /tmp/n5000-log.all > "$MARK"
fi
rm -f /tmp/n5000-log.all /tmp/n5000-log.new
