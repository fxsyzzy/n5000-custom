#!/bin/sh
# N5000 运行模式应用
# 用法: n5000-mode-apply high|low|entertainment|game
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

MODE="$1"
case "$MODE" in
high|low|entertainment|game) ;;
*) echo "unknown mode: $MODE"; exit 1 ;;
esac

FREQ_MIN=500000
case "$MODE" in
high)
	GOV=performance; FREQ_MAX=2000000; HNAT=1; SQM=0 ;;
low)
	GOV=powersave; FREQ_MAX=1300000; HNAT=1; SQM=0 ;;
entertainment)
	GOV=schedutil; FREQ_MAX=2000000; HNAT=1; SQM=0 ;;
game)
	GOV=performance; FREQ_MAX=2000000; HNAT=0; SQM=1 ;;
esac

# 游戏模式安全策略：未配置带宽时不做限速（回退为 HNAT，避免误限速）
SQM_WARN=0
if [ "$SQM" = "1" ]; then
	DL=$(uci -q get sqm.eth1.download 2>/dev/null)
	UL=$(uci -q get sqm.eth1.upload 2>/dev/null)
	BW_CONF=$(uci -q get n5000.mode.bw_configured 2>/dev/null)
	unconf=0
	case "$DL" in ''|0|*[!0-9]*) unconf=1 ;; esac
	case "$UL" in ''|0|*[!0-9]*) unconf=1 ;; esac
	# 占位默认值（85M/10M）且未标记已配置，同样视为未配置
	if [ "$BW_CONF" != "1" ] && [ "$DL" = "85000" ] && [ "$UL" = "10000" ]; then
		unconf=1
	fi
	if [ "$unconf" = "1" ]; then
		SQM=0
		HNAT=1
		SQM_WARN=1
	fi
fi

# 1) CPU 调频
for pol in /sys/devices/system/cpu/cpufreq/policy*; do
	[ -d "$pol" ] || continue
	echo "$FREQ_MIN" > "$pol/scaling_min_freq" 2>/dev/null
	echo "$FREQ_MAX" > "$pol/scaling_max_freq" 2>/dev/null
	echo "$GOV" > "$pol/scaling_governor" 2>/dev/null
done

# 2) 流量加速（HNAT）
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw="$HNAT"
uci -q commit firewall

# 3) SQM（游戏模式启用低延迟整形）
if [ "$SQM" = "1" ]; then
	uci -q set sqm.eth1.enabled='1'
	[ -f /usr/lib/sqm/layer_cake.qos ] && uci -q set sqm.eth1.script='layer_cake.qos'
else
	uci -q set sqm.eth1.enabled='0'
fi
uci -q commit sqm

# 4) 与游戏加速页状态同步
if [ "$MODE" = "game" ]; then
	uci -q set gameaccel.settings.mode='lowlatency'
else
	uci -q set gameaccel.settings.mode='speed'
fi
uci -q commit gameaccel

# 5) 应用服务
/etc/init.d/firewall restart >/dev/null 2>&1
if [ "$SQM" = "1" ]; then
	/etc/init.d/sqm restart >/dev/null 2>&1
else
	/etc/init.d/sqm stop >/dev/null 2>&1
fi

# 6) WiFi 省电关闭（AP 模式通常无效，容错）
for d in /sys/class/net/phy0.0-ap0 /sys/class/net/phy0.1-ap0; do
	[ -d "$d" ] && iw dev "$(basename "$d")" set power_save off 2>/dev/null
done

# 7) 应用 DSCP 规则并记录模式
/usr/sbin/gameaccel-apply >/dev/null 2>&1
uci -q set n5000.mode.current="$MODE"
uci -q commit n5000

if [ "$SQM_WARN" = "1" ]; then
	echo "warn=bandwidth_not_configured"
fi
echo "mode=$MODE governor=$GOV max_freq=$FREQ_MAX hnat=$HNAT sqm=$SQM"
