#!/bin/sh
# 安全浏览模式管理接口
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

parse_qs() { printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n1; }
ACTION=$(parse_qs action)
[ -z "$ACTION" ] && ACTION=status

case "$ACTION" in
status)
	exec /usr/sbin/n5000-safebrowse status
	;;
on|off|clear)
	OUT=$(/usr/sbin/n5000-safebrowse "$ACTION" 2>&1)
	RC=$?
	if [ $RC -ne 0 ]; then
		printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
		jq -n --arg e "$OUT" '{code:-1,error:$e}'
		exit 0
	fi
	exec /usr/sbin/n5000-safebrowse status
	;;
*)
	printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
	jq -n '{code:-1,error:"unknown action"}'
	;;
esac
