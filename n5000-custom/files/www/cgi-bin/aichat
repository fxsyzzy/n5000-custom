#!/bin/sh
# aichat CGI — DeepSeek / OpenAI-compatible AI assistant backend
# actions:
#   GET  ?action=config       -> return config (key masked)
#   POST ?action=config       -> save config (JSON body)
#   POST ?action=chat         -> {"messages":[{role,content}...]} -> {"code":0,"reply":"..."}
#   GET  ?action=snapshot     -> router status JSON
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 022

send_json() {
	printf 'Content-Type: application/json; charset=utf-8\r\nCache-Control: no-store\r\n\r\n'
}
fail() {
	send_json
	jq -n --arg e "$1" '{code:-1,error:$e}'
	exit 0
}

read_body() {
	local len="${CONTENT_LENGTH:-0}"
	if [ "$len" -gt 0 ] 2>/dev/null; then
		head -c "$len"
	fi
}

uciget() { uci -q get "aichat.$1" 2>/dev/null; }
trim_base() { printf '%s' "$1" | sed 's:/*$::'; }

snapshot() {
	/www/cgi-bin/rstatus 2>/dev/null | tail -n1 | jq -c '{host,uptime,load,mem_total,mem_avail,swap_total,swap_free,temp,wan_ip,lan_ip,ssid,clients,docker,docker_count,pw,pw_enabled,modem,modem_ip,tf_used,tf_total}' 2>/dev/null
}

TOOLS_JSON='[
 {"type":"function","function":{"name":"get_status","description":"Get router status: uptime, load, memory, temperature, WAN/LAN IP, WiFi SSID, clients, docker","parameters":{"type":"object","properties":{}}}},
 {"type":"function","function":{"name":"list_clients","description":"List connected wireless clients with signal strength","parameters":{"type":"object","properties":{}}}},
 {"type":"function","function":{"name":"reboot_router","description":"Reboot the router now","parameters":{"type":"object","properties":{}}}},
 {"type":"function","function":{"name":"restart_wifi","description":"Restart/reload WiFi","parameters":{"type":"object","properties":{}}}},
 {"type":"function","function":{"name":"set_wifi_password","description":"Set the WiFi password for both 2.4G and 5G","parameters":{"type":"object","properties":{"password":{"type":"string","description":"new WiFi password, at least 8 chars"}},"required":["password"]}}}
]'

run_tool() {
	local name="$1" args="$2" pw
	case "$name" in
	get_status)
		snapshot
		;;
	list_clients)
		for dev in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
			case "$dev" in *-ap*)
				iw dev "$dev" station dump 2>/dev/null | awk -v d="$dev" '/^Station/{mac=$2} /signal:/{print d" "mac" " $2" dBm"}' | head -20
				;;
			esac
		done
		;;
	reboot_router)
		( sleep 2; reboot ) >/dev/null 2>&1 &
		echo "reboot scheduled"
		;;
	restart_wifi)
		wifi reload >/dev/null 2>&1
		echo "wifi reloaded"
		;;
	set_wifi_password)
		pw=$(printf '%s' "$args" | jq -r '.password // empty' 2>/dev/null)
		if [ ${#pw} -lt 8 ]; then
			echo "error: password too short (min 8 chars)"
		else
			for iface in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
				uci set "wireless.$iface.key=$pw"
			done
			uci commit wireless
			wifi reload >/dev/null 2>&1
			echo "wifi password updated"
		fi
		;;
	*)
		echo "unknown tool: $name"
		;;
	esac
}

call_api() {
	local msgs="$1" tools="$2" base key model temp maxt payload
	base=$(trim_base "$(uciget main.api_base)")
	key=$(uciget main.api_key)
	model=$(uciget main.model)
	temp=$(uciget main.temperature); [ -z "$temp" ] && temp=0.7
	maxt=$(uciget main.max_tokens); [ -z "$maxt" ] && maxt=800
	[ -z "$key" ] && return 1
	[ -z "$base" ] && base="https://api.deepseek.com"
	[ -z "$model" ] && model="deepseek-chat"
	payload=$(printf '%s' "$msgs" | jq -c --arg m "$model" --argjson t "$temp" --argjson mt "$maxt" --argjson tools "${tools:-null}" \
		'{model:$m, messages:., temperature:$t, max_tokens:$mt} + (if $tools then {tools:$tools, tool_choice:"auto"} else {} end)' 2>/dev/null) || return 1
	curl -sS -m 60 -H 'Content-Type: application/json' -H "Authorization: Bearer $key" -d "$payload" "$base/chat/completions" 2>/dev/null
}

action_from_query() {
	printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n 's/^action=//p' | head -n1
}

ACTION=$(action_from_query)

case "$ACTION" in
config)
	if [ "$REQUEST_METHOD" = "POST" ]; then
		DATA=$(read_body)
		printf '%s' "$DATA" | jq -e . >/dev/null 2>&1 || { fail "invalid json"; exit 0; }
		for k in api_base model system_prompt language; do
			v=$(printf '%s' "$DATA" | jq -r --arg k "$k" '.[$k] // empty')
			[ -n "$v" ] && uci set "aichat.main.$k=$v"
		done
		v=$(printf '%s' "$DATA" | jq -r 'if .api_key and (.api_key|length)>0 then .api_key else empty end')
		[ -n "$v" ] && uci set "aichat.main.api_key=$v"
		v=$(printf '%s' "$DATA" | jq -r 'if .allow_tools == true then "1" elif .allow_tools == false then "0" else empty end')
		[ -n "$v" ] && uci set "aichat.main.allow_tools=$v"
		v=$(printf '%s' "$DATA" | jq -r 'if .enabled == true then "1" elif .enabled == false then "0" else empty end')
		[ -n "$v" ] && uci set "aichat.main.enabled=$v"
		v=$(printf '%s' "$DATA" | jq -r 'if .mascot_ai == true then "1" elif .mascot_ai == false then "0" else empty end')
		[ -n "$v" ] && uci set "aichat.main.mascot_ai=$v"
		uci commit aichat 2>/dev/null
		send_json
		jq -n '{code:0}'
	else
		send_json
		key=$(uciget main.api_key)
		has_key=false
		[ -n "$key" ] && has_key=true
		jq -n --arg base "$(uciget main.api_base)" --arg model "$(uciget main.model)" \
			--arg prompt "$(uciget main.system_prompt)" --arg lang "$(uciget main.language)" \
			--arg tools "$(uciget main.allow_tools)" --arg enabled "$(uciget main.enabled)" \
			--argjson haskey "$has_key" --arg ma "$(uciget main.mascot_ai)" \
			'{code:0,api_base:$base,model:$model,system_prompt:$prompt,language:$lang,allow_tools:($tools=="1"),enabled:($enabled!="0"),has_key:$haskey,mascot_ai:($ma != "0")}'
	fi
	;;
line)
	KEY=$(uciget main.api_key)
	[ -z "$KEY" ] && { send_json; jq -n '{code:-1,error:"no_key"}'; exit 0; }
	[ "$(uciget main.mascot_ai)" = "0" ] && { send_json; jq -n '{code:-1,error:"disabled"}'; exit 0; }
	BASE=$(trim_base "$(uciget main.api_base)"); [ -z "$BASE" ] && BASE="https://api.deepseek.com"
	MODEL=$(uciget main.model); [ -z "$MODEL" ] && MODEL="deepseek-chat"
	STATUS=$(snapshot)
	SYS="你是 N5000 路由器上的吉祥物「大肥鱼」——DeepSeek 鲸鱼娘：蓝发、鲸鱼尾、女仆装、呆毛，性格傲娇、爱吃白饭、爱摸鱼、偶尔 DeepSleep。
根据下面的路由器实时状态，用一句不超过 35 个字的中文傲娇/吐槽语录回应，可以带一点白饭或摸鱼梗。只输出这一句话本身，不要引号、不要解释、不要前缀。
路由器状态：$STATUS"
	PAYLOAD=$(jq -n -c --arg m "$MODEL" --arg sys "$SYS" '{model:$m, messages:[{role:"system",content:$sys},{role:"user",content:"来一句"}], temperature:1.0, max_tokens:60, stream:false}' 2>/dev/null)
	RESP=$(curl -sS -m 20 -H 'Content-Type: application/json' -H "Authorization: Bearer $KEY" -d "$PAYLOAD" "$BASE/chat/completions" 2>/dev/null)
	LINE=$(printf '%s' "$RESP" | jq -r '.choices[0].message.content // empty' 2>/dev/null | tr -d '\n' | sed 's/^["“]//; s/["”]$//' | cut -c1-80)
	if [ -z "$LINE" ]; then
		ERR=$(printf '%s' "$RESP" | jq -r '.error.message // empty' 2>/dev/null)
		send_json; jq -n --arg e "${ERR:-AI 无返回}" '{code:-1,error:$e}'
		exit 0
	fi
	send_json; jq -n --arg l "$LINE" '{code:0,line:$l}'
	;;
snapshot)
	send_json
	snapshot
	;;
chat)
	[ "$REQUEST_METHOD" = "POST" ] || { fail "POST required"; exit 0; }
	DATA=$(read_body)
	printf '%s' "$DATA" | jq -e '.messages | type == "array"' >/dev/null 2>&1 || { fail "messages required"; exit 0; }
	MSGS=$(printf '%s' "$DATA" | jq -c '.messages' 2>/dev/null)
	[ -z "$MSGS" ] && MSGS='[]'
	ENABLED=$(uciget main.enabled)
	[ "$ENABLED" = "0" ] && { fail "AI 助手已在设置中禁用"; exit 0; }
	SYS=$(uciget main.system_prompt)
	ALLOW=$(uciget main.allow_tools)
	STATUS=$(snapshot)
	if [ -n "$STATUS" ]; then
		SYS="$SYS

当前路由器实时状态:
$STATUS"
	fi
	MSGS=$(jq -n -c --arg sys "$SYS" --argjson m "$MSGS" '[{role:"system",content:$sys}] + ($m | map(select(.role=="user" or .role=="assistant")))' 2>/dev/null)
	[ -z "$MSGS" ] && { fail "bad messages"; exit 0; }
	TOOLS=""
	[ "$ALLOW" = "1" ] && TOOLS="$TOOLS_JSON"
	RESP=$(call_api "$MSGS" "$TOOLS")
	if [ -z "$RESP" ]; then
		fail "无法连接 AI 服务：请检查 API 地址 / Key / 网络（设置页可修改）"
		exit 0
	fi
	TC=$(printf '%s' "$RESP" | jq -c '.choices[0].message.tool_calls // empty' 2>/dev/null)
	TOOLNAMES=""
	if [ -n "$TC" ] && [ "$ALLOW" = "1" ]; then
		ASST=$(printf '%s' "$RESP" | jq -c '.choices[0].message' 2>/dev/null)
		RESULTS='[]'
		for item in $(printf '%s' "$TC" | jq -c '.[]' 2>/dev/null); do
			TID=$(printf '%s' "$item" | jq -r '.id // ""')
			TNAME=$(printf '%s' "$item" | jq -r '.function.name // ""')
			TARGS=$(printf '%s' "$item" | jq -r '.function.arguments // "{}"')
			TOUT=$(run_tool "$TNAME" "$TARGS")
			TOOLNAMES="$TOOLNAMES $TNAME"
			RESULTS=$(printf '%s' "$RESULTS" | jq -c --arg id "$TID" --arg n "$TNAME" --arg o "$TOUT" '. + [{role:"tool",tool_call_id:$id,name:$n,content:$o}]')
		done
		MSGS2=$(jq -n -c --argjson prev "$MSGS" --argjson a "$ASST" --argjson r "$RESULTS" '$prev + [$a] + $r' 2>/dev/null)
		RESP2=$(call_api "$MSGS2" "")
		[ -n "$RESP2" ] && RESP="$RESP2"
	fi
	REPLY=$(printf '%s' "$RESP" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
	if [ -z "$REPLY" ]; then
		ERR=$(printf '%s' "$RESP" | jq -r '.error.message // empty' 2>/dev/null)
		[ -n "$ERR" ] && { fail "AI 返回错误：$ERR"; exit 0; }
		REPLY="（AI 无返回内容）"
	fi
	send_json
	jq -n --arg r "$REPLY" --arg t "$TOOLNAMES" '{code:0,reply:$r,tools:$t}'
	;;
*)
	send_json
	jq -n '{code:-1,error:"unknown action",actions:["config","chat","snapshot"]}'
	;;
esac
