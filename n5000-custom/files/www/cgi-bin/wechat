#!/bin/sh
# WeChat official-account callback for the N5000 AI assistant.
# GET  : signature verification
# POST : receive text message, reply via passive reply (XML)
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

cdata() {
	printf '%s' "$1" | sed -e 's/]]>/]]]]><![CDATA[>/g'
}
uciget() { uci -q get "aichat.$1" 2>/dev/null; }

# ---------- signature check ----------
# WeChat algorithm: sort token/timestamp/nonce lexicographically, concat, sha1.
# No sha1sum applet in this busybox build -> use ucode digest module.
verify() {
	[ -z "$WX_TOKEN" ] && return 1
	CALC=$(ucode -e '
	import * as digest from "digest";
	let a = [ARGV[0], ARGV[1], ARGV[2]], t;
	if (a[0] > a[1]) { t=a[0]; a[0]=a[1]; a[1]=t; }
	if (a[1] > a[2]) { t=a[1]; a[1]=a[2]; a[2]=t; }
	if (a[0] > a[1]) { t=a[0]; a[0]=a[1]; a[1]=t; }
	print(digest.sha1(a[0]+a[1]+a[2]));
	' "$WX_TOKEN" "$WX_TIMESTAMP" "$WX_NONCE" 2>/dev/null)
	[ -n "$CALC" ] && [ "$CALC" = "$WX_SIGN" ]
}

# ---------- reply helpers ----------
reply_text() {
	FROM="$1"; TO="$2"; TEXT="$3"
	printf 'Content-Type: text/xml; charset=utf-8\r\n\r\n'
	printf '<xml><ToUserName><![CDATA[%s]]></ToUserName><FromUserName><![CDATA[%s]]></FromUserName><CreateTime>%s</CreateTime><MsgType><![CDATA[text]]></MsgType><Content><![CDATA[%s]]></Content></xml>' \
		"$FROM" "$TO" "$(date +%s)" "$(cdata "$TEXT")"
	exit 0
}
reply_empty() {
	printf 'Content-Type: text/plain\r\n\r\nsuccess'
	exit 0
}
parse_qs() {
	printf '%s' "$QUERY_STRING" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n1
}

WX_TOKEN=$(uciget wechat.token)
WX_ENABLED=$(uciget wechat.enabled)
WX_TIMEOUT=$(uciget wechat.reply_timeout); [ -z "$WX_TIMEOUT" ] && WX_TIMEOUT=4

# ---------- GET: server URL verification ----------
if [ "$REQUEST_METHOD" = "GET" ]; then
	WX_SIGN=$(parse_qs signature)
	WX_TIMESTAMP=$(parse_qs timestamp)
	WX_NONCE=$(parse_qs nonce)
	WX_ECHO=$(parse_qs echostr)
	if verify; then
		printf 'Content-Type: text/plain\r\n\r\n%s' "$WX_ECHO"
	else
		printf 'Content-Type: text/plain\r\n\r\ninvalid signature'
	fi
	exit 0
fi

[ "$WX_ENABLED" = "1" ] || reply_empty

LEN="${CONTENT_LENGTH:-0}"
[ "$LEN" -gt 0 ] 2>/dev/null || reply_empty
XML=$(head -c "$LEN" | tr -d '\n\r')

MSG_TYPE=$(printf '%s' "$XML" | sed -n 's:.*<MsgType><!\[CDATA\[\([^]]*\)\]\]></MsgType>.*:\1:p')
FROM=$(printf '%s' "$XML" | sed -n 's:.*<FromUserName><!\[CDATA\[\([^]]*\)\]\]></FromUserName>.*:\1:p')
TO=$(printf '%s' "$XML" | sed -n 's:.*<ToUserName><!\[CDATA\[\([^]]*\)\]\]></ToUserName>.*:\1:p')
CONTENT=$(printf '%s' "$XML" | sed -n 's:.*<Content><!\[CDATA\[\(.*\)\]\]></Content>.*:\1:p')

[ -z "$FROM" ] && reply_empty
[ -z "$TO" ] && TO="n5000"

case "$MSG_TYPE" in
event)
	EVENT=$(printf '%s' "$XML" | sed -n 's:.*<Event><!\[CDATA\[\([^]]*\)\]\]></Event>.*:\1:p')
	if [ "$EVENT" = "subscribe" ]; then
		reply_text "$FROM" "$TO" "你好，我是 N5000 路由器 AI 助手。直接发消息就能聊天；也可以发：状态 / 重启 / 重启wifi / 改密码 新密码"
	else
		reply_empty
	fi
	;;
text) ;;
*)
	reply_text "$FROM" "$TO" "目前只支持文字消息。"
	;;
esac

# ---------- fast commands (no AI round-trip, guaranteed under 5s) ----------
CMD=$(printf '%s' "$CONTENT" | tr -d ' ')
case "$CMD" in
状态|status)
	ST=$(/www/cgi-bin/rstatus 2>/dev/null | tail -n1 | jq -r '"主机: \(.host)\n运行: \(.uptime) 秒\n负载: \(.load[0])\n温度: \((.temp/1000)|floor)°C\n内存: \(.mem_avail/1024|floor)MB 可用 / \(.mem_total/1024|floor)MB\nWAN: \(.wan_ip)\nLAN: \(.lan_ip)\nWiFi: \(.ssid) (\(.clients) 台在线)\nPassWall: \(if .pw_enabled==1 then "已启用" else "未启用" end)\nDocker: \(if .docker==true then "运行中" else "未运行" end)"' 2>/dev/null)
	[ -z "$ST" ] && ST="读取状态失败"
	reply_text "$FROM" "$TO" "$ST"
	;;
重启|reboot)
	( sleep 1; reboot ) >/dev/null 2>&1 &
	reply_text "$FROM" "$TO" "正在重启路由器，约 60 秒后回来。"
	;;
重启wifi|restartwifi|wifi)
	wifi reload >/dev/null 2>&1
	reply_text "$FROM" "$TO" "WiFi 已重启。"
	;;
改密码*)
	NEWPW=$(printf '%s' "$CONTENT" | sed -n 's/^改密码[[:space:]]*//p')
	if [ ${#NEWPW} -lt 8 ]; then
		reply_text "$FROM" "$TO" "密码太短：至少 8 位，例如：改密码 12345678"
	else
		for iface in $(uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'); do
			uci set "wireless.$iface.key=$NEWPW"
		done
		uci commit wireless
		wifi reload >/dev/null 2>&1
		reply_text "$FROM" "$TO" "WiFi 密码已修改为：$NEWPW"
	fi
	;;
*)
	# ---------- call the LLM ----------
	BASE=$(uciget main.api_base | sed 's:/*$::')
	KEY=$(uciget main.api_key)
	MODEL=$(uciget main.model); [ -z "$MODEL" ] && MODEL="deepseek-chat"
	SYS=$(uciget main.system_prompt)
	[ -z "$BASE" ] && BASE="https://api.deepseek.com"
	if [ -z "$KEY" ]; then
		reply_text "$FROM" "$TO" "AI Key 还没配置，请登录 http://192.168.88.1/aichat.html 设置。"
	fi
	STATUS=$(/www/cgi-bin/rstatus 2>/dev/null | tail -n1 | jq -c '{host,uptime,load,temp,wan_ip,lan_ip,ssid,clients,pw_enabled,docker}' 2>/dev/null)
	[ -n "$STATUS" ] && SYS="$SYS
当前路由器状态（仅供参考）：$STATUS"
	PAYLOAD=$(jq -n -c --arg m "$MODEL" --arg sys "$SYS" --arg txt "$CONTENT" \
		'{model:$m, messages:[{role:"system",content:$sys},{role:"user",content:$txt}], temperature:0.7, max_tokens:600, stream:false}' 2>/dev/null)
	RESP=$(curl -sS -m "$WX_TIMEOUT" -H 'Content-Type: application/json' -H "Authorization: Bearer $KEY" -d "$PAYLOAD" "$BASE/chat/completions" 2>/dev/null)
	REPLY=$(printf '%s' "$RESP" | jq -r '.choices[0].message.content // empty' 2>/dev/null)
	if [ -z "$REPLY" ]; then
		if [ -z "$RESP" ]; then
			reply_text "$FROM" "$TO" "AI 响应超时了，请稍后再发一次（或把问题缩短一点）。"
		else
			ERR=$(printf '%s' "$RESP" | jq -r '.error.message // empty' 2>/dev/null)
			[ -z "$ERR" ] && ERR="AI 服务异常，请检查 Key 和网络。"
			reply_text "$FROM" "$TO" "出错了：$ERR"
		fi
	fi
	reply_text "$FROM" "$TO" "$REPLY"
	;;
esac
