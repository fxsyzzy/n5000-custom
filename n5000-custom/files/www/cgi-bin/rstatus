#!/bin/sh
# N5000 ????????JSON?
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\n\r\n'

UP=$(cut -d. -f1 /proc/uptime 2>/dev/null)
set -- $(cat /proc/loadavg 2>/dev/null)
L1=$1; L5=$2; L15=$3

MEMT=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null)
MEMA=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
SWT=$(awk '/^SwapTotal:/{print $2}' /proc/meminfo 2>/dev/null)
SWF=$(awk '/^SwapFree:/{print $2}' /proc/meminfo 2>/dev/null)

TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0)

set -- $(df -k / 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
RT=$1; RU=$2; RF=$3
set -- $(df -k /overlay 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
TT=$1; TU=$2; TFREE=$3

WANIP=$(ip -4 addr show eth1 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
LANIP=$(ip -4 addr show br-lan 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
[ -z "$LANIP" ] && LANIP=$(ip -4 addr show eth0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
LANDEV=br-lan
[ -d /sys/class/net/br-lan ] || LANDEV=eth0
WRX=$(cat /sys/class/net/eth1/statistics/rx_bytes 2>/dev/null || echo 0)
WTX=$(cat /sys/class/net/eth1/statistics/tx_bytes 2>/dev/null || echo 0)
LRX=$(cat /sys/class/net/$LANDEV/statistics/rx_bytes 2>/dev/null || echo 0)
LTX=$(cat /sys/class/net/$LANDEV/statistics/tx_bytes 2>/dev/null || echo 0)

SSID=$(iwinfo 2>/dev/null | sed -n 's/.*ESSID: "\([^"]*\)".*/\1/p' | head -n1)
[ -z "$SSID" ] && SSID="--"
CLIENTS=0
for dev in $(iw dev 2>/dev/null | awk '/Interface/{print $2}'); do
	case "$dev" in
		*-ap*) n=$(iw dev "$dev" station dump 2>/dev/null | grep -c '^Station'); CLIENTS=$((CLIENTS + n)) ;;
	esac
done

if pgrep -f 'xray|sing-box|v2ray|hysteria' >/dev/null 2>&1; then PW=true; else PW=false; fi
PWEN=$(uci -q get passwall.@global[0].enabled 2>/dev/null)
[ -z "$PWEN" ] && PWEN=0

if pidof dockerd >/dev/null 2>&1; then DOCKER=true; else DOCKER=false; fi
DCON=0
if [ "$DOCKER" = "true" ]; then
	DCON=$(docker ps -q 2>/dev/null | wc -l)
fi

if ip -4 addr show usb0 >/dev/null 2>&1; then MODEM=true; else MODEM=false; fi
MODEMIP=$(ip -4 addr show usb0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
[ -z "$MODEMIP" ] && MODEMIP="--"

TFMODEL=$(cat /sys/block/mmcblk0/device/name 2>/dev/null || echo "TF")
ERRS=$(dmesg 2>/dev/null | grep -ciE 'I/O error|EXT_CSD|mmc.*error|f2fs.*error')
HOST=$(cat /proc/sys/kernel/hostname 2>/dev/null)
TS=$(date +%s)

printf '{"host":"%s","uptime":%s,"load":[%s,%s,%s],"mem_total":%s,"mem_avail":%s,"swap_total":%s,"swap_free":%s,"temp":%s,"root_total":%s,"root_used":%s,"root_free":%s,"tf_total":%s,"tf_used":%s,"tf_free":%s,"wan_ip":"%s","wan_rx":%s,"wan_tx":%s,"lan_ip":"%s","lan_rx":%s,"lan_tx":%s,"ssid":"%s","clients":%s,"pw":%s,"pw_enabled":%s,"docker":%s,"docker_count":%s,"modem":%s,"modem_ip":"%s","tf_model":"%s","errs":%s,"ts":%s}\n' \
  "$HOST" "${UP:-0}" "${L1:-0}" "${L5:-0}" "${L15:-0}" \
  "${MEMT:-0}" "${MEMA:-0}" "${SWT:-0}" "${SWF:-0}" "${TEMP:-0}" \
  "${RT:-0}" "${RU:-0}" "${RF:-0}" "${TT:-0}" "${TU:-0}" "${TFREE:-0}" \
  "$WANIP" "${WRX:-0}" "${WTX:-0}" "$LANIP" "${LRX:-0}" "${LTX:-0}" \
  "$SSID" "${CLIENTS:-0}" "$PW" "${PWEN:-0}" "$DOCKER" "${DCON:-0}" \
  "$MODEM" "$MODEMIP" "$TFMODEL" "${ERRS:-0}" "$TS"

